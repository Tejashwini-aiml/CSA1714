

graph = {
    'A': [['B', 'C'], ['D']],
    'B': [['E', 'F']],
    'C': [['G']],
    'D': [['H', 'I']],
    'E': [], 'F': [], 'G': [], 'H': [], 'I': []
}

cost = {
    'A': 1, 'B': 1, 'C': 1, 'D': 1,
    'E': 0, 'F': 0, 'G': 0, 'H': 0, 'I': 0
}

def ao_star(node):
    if not graph[node]:
        return cost[node], [node]

    best_cost = float('inf')
    best_path = []

    for option in graph[node]:
        total = 1
        path = [node]

        for child in option:
            child_cost, child_path = ao_star(child)
            total += child_cost
            path += child_path

        if total < best_cost:
            best_cost = total
            best_path = path

    return best_cost, best_path

result, path = ao_star('A')

print("Optimal Cost:", result)
print("Optimal Solution Path:", path)
